{
  "name": "forge",
  "version": "2.5.0-beta",
  "desktopName": "forge.desktop",
  "private": true,
  "description": "Local-first AI-native development workspace",
  "author": {
    "name": "Kaegan Scott",
    "email": "kaeganscott26@gmail.com"
  },
  "homepage": "https://github.com/North3rnLight3r/FORGE",
  "repository": {
    "type": "git",
    "url": "https://github.com/North3rnLight3r/FORGE.git"
  },
  "type": "module",
  "main": "apps/desktop/out/main/index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/prepare-node-pty.mjs",
    "dev": "electron-vite dev apps/desktop",
    "start-renderer": "vite apps/desktop/src/renderer",
    "build": "npm run typecheck && electron-vite build apps/desktop",
    "clean:dist": "rimraf dist_electron",
    "stage:mac-runtime-metadata": "node scripts/stage-runtime-metadata.mjs darwin",
    "stage:win-runtime-metadata": "node scripts/stage-runtime-metadata.mjs win32",
    "stage:linux-runtime-metadata": "node scripts/stage-runtime-metadata.mjs linux",
    "package:mac": "npm run clean:dist && npm run build && npm run stage:mac-runtime-metadata && electron-builder --mac --arm64 --publish never && node scripts/write-build-manifest.mjs arm64",
    "package:mac:universal": "npm run clean:dist && npm run build && npm run stage:mac-runtime-metadata && electron-builder --mac --universal --publish never && node scripts/write-build-manifest.mjs universal",
    "package:mac:all": "npm run clean:dist && npm run build && npm run stage:mac-runtime-metadata && electron-builder --mac --arm64 --publish never && electron-builder --mac --universal --publish never && node scripts/write-build-manifest.mjs arm64,universal",
    "package:win": "npm run clean:dist && npm run build && npm run stage:win-runtime-metadata && electron-builder --win --x64 --publish never && node scripts/write-build-manifest.mjs x64 win32",
    "package:linux": "npm run clean:dist && npm run build && npm run stage:linux-runtime-metadata && electron-builder --linux --x64 --publish never && node scripts/write-build-manifest.mjs x64 linux",
    "install:mac": "bash scripts/install-mac.sh",
    "update:mac": "bash scripts/update-macos.sh",
    "update:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-windows.ps1",
    "preview": "electron-vite preview apps/desktop",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:release-version": "node scripts/verify-release-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "profile:semantic-memory": "node --expose-gc node_modules/vite-node/vite-node.mjs scripts/profile-semantic-memory.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "clean": "rimraf apps/desktop/out apps/desktop/dist coverage dist_electron"
  },
  "build": {
    "appId": "com.kaeganscott26.forge",
    "productName": "FORGE",
    "icon": "apps/desktop/resources/ForgeIcon-v2.5-1024.png",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "apps/desktop/out/**/*",
      "node_modules/**/*",
      "!node_modules/node-pty/prebuilds/**/*",
      "package.json"
    ],
    "asar": true,
    "generateUpdatesFilesForAllChannels": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": "build/forge-runtime.json",
        "to": "forge-runtime.json"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "North3rnLight3r",
        "repo": "FORGE",
        "releaseType": "prerelease",
        "channel": "beta"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "apps/desktop/resources/ForgeIcon-v2.5-1024.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "apps/desktop/out/**/*",
        "node_modules/**/*",
        "package.json"
      ]
    },
    "linux": {
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "apps/desktop/resources/ForgeIcon-v2.5-1024.png"
    }
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.7.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^9.17.0",
    "globals": "^15.15.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource-variable/oxanium": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@monaco-editor/react": "^4.6.0",
    "@types/three": "^0.185.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "marked": "^15.0.0",
    "monaco-editor": "0.53.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-git": "^3.27.0",
    "sql.js": "^1.12.0",
    "three": "^0.185.1",
    "undici": "^7.29.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.0"
  },
  "allowScripts": {
    "electron@43.3.0": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "node-pty@1.1.0": true
  },
  "overrides": {
    "@electron/asar": "^4.2.1"
  }
}
