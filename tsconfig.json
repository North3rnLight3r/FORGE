{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": "",
    "paths": {
      "@forge/ipc": ["packages/ipc/src/index.ts"],
      "@forge/workspace": ["packages/workspace/src/index.ts"],
      "@forge/git": ["packages/git/src/index.ts"],
      "@forge/storage": ["packages/storage/src/index.ts"]
      , "@forge/agent-tools": ["packages/agent-tools/src/index.ts"]
      , "@forge/tool-runtime": ["packages/tool-runtime/src/index.ts"]
      , "@forge/shell": ["packages/shell/src/index.ts"]
      , "@forge/web": ["packages/web/src/index.ts"]
      , "@forge/tasks": ["packages/tasks/src/index.ts"]
      , "@forge/os-integration": ["packages/os-integration/src/index.ts"]
      , "@forge/agent-runtime": ["packages/agent-runtime/src/index.ts"]
      , "@forge/forge-live": ["packages/forge-live/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "vitest.config.ts"]
}
